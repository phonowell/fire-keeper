{
  "name": "fire-keeper",
  "version": "0.0.239",
  "description": "A lightweight toolkit for Node.js automation tasks.",
  "keywords": [
    "automation",
    "cli",
    "concurrency",
    "esm",
    "file-operations",
    "file-watcher",
    "filesystem",
    "fire-keeper",
    "glob",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/phonowell/fire-keeper",
  "bugs": {
    "url": "https://github.com/phonowell/fire-keeper/issues"
  },
  "license": "MIT",
  "author": "Mimiko Phonowell <phonowell@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phonowell/fire-keeper.git"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./argv": "./dist/argv.js",
    "./at": "./dist/at.js",
    "./backup": "./dist/backup.js",
    "./clean": "./dist/clean.js",
    "./copy": "./dist/copy.js",
    "./download": "./dist/download.js",
    "./echo": "./dist/echo.js",
    "./exec": "./dist/exec.js",
    "./findIndex": "./dist/findIndex.js",
    "./flatten": "./dist/flatten.js",
    "./getBasename": "./dist/getBasename.js",
    "./getDirname": "./dist/getDirname.js",
    "./getExtname": "./dist/getExtname.js",
    "./getFilename": "./dist/getFilename.js",
    "./getName": "./dist/getName.js",
    "./glob": "./dist/glob.js",
    "./home": "./dist/home.js",
    "./isExist": "./dist/isExist.js",
    "./isSame": "./dist/isSame.js",
    "./mkdir": "./dist/mkdir.js",
    "./move": "./dist/move.js",
    "./normalizePath": "./dist/normalizePath.js",
    "./os": "./dist/os.js",
    "./prompt": "./dist/prompt.js",
    "./read": "./dist/read.js",
    "./recover": "./dist/recover.js",
    "./remove": "./dist/remove.js",
    "./rename": "./dist/rename.js",
    "./root": "./dist/root.js",
    "./run": "./dist/run.js",
    "./runConcurrent": "./dist/runConcurrent.js",
    "./sleep": "./dist/sleep.js",
    "./stat": "./dist/stat.js",
    "./toArray": "./dist/toArray.js",
    "./toDate": "./dist/toDate.js",
    "./trimEnd": "./dist/trimEnd.js",
    "./watch": "./dist/watch.js",
    "./wrapList": "./dist/wrapList.js",
    "./write": "./dist/write.js",
    "./zip": "./dist/zip.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm task build",
    "fmt": "oxfmt",
    "lint": "oxlint --type-aware --fix && oxfmt",
    "task": "tsx tasks/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "ansis": "^4.4.0",
    "archiver": "^8.0.0",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "js-yaml": "^5.4.2",
    "prompts": "^2.4.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.0",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "url": "https://github.com/phonowell/fire-keeper"
}
